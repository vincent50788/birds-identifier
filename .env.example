# Copy to .env (repo root). Read by frontend/run.py.

# 1 = run the UI against the local mock API, no AWS needed (any email/password signs in)
DEMO_MODE=1
JWT_SECRET=replace-with-a-long-random-string

# Only used when DEMO_MODE=0
API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
AWS_REGION=us-east-1
